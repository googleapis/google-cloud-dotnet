{
  "schema": "1.0",
  "comment": "This file maps proto services/RPCs to the corresponding library clients/methods",
  "language": "csharp",
  "protoPackage": "google.shopping.merchant.reviews.v1",
  "libraryPackage": "Google.Shopping.Merchant.Reviews.V1",
  "services": {
    "ProductReviewsService": {
      "clients": {
        "grpc": {
          "libraryClient": "ProductReviewsServiceClient",
          "rpcs": {
            "DeleteProductReview": {
              "methods": [
                "DeleteProductReview",
                "DeleteProductReviewAsync"
              ]
            },
            "GetProductReview": {
              "methods": [
                "GetProductReview",
                "GetProductReviewAsync"
              ]
            },
            "InsertProductReview": {
              "methods": [
                "InsertProductReview",
                "InsertProductReviewAsync"
              ]
            },
            "ListProductReviews": {
              "methods": [
                "ListProductReviews",
                "ListProductReviewsAsync"
              ]
            }
          }
        }
      }
    }
  }
}
