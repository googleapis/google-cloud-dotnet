<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0-alpha01</Version>
    <TargetFrameworks>netstandard2.0;net462</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>OpenTelemetry exporter and setup for Google Cloud client built-in metrics.</Description>
    <PackageTags>OpenTelemetry;Metrics;Google;Cloud;Google;Cloud</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ConfigureAwaitChecker.Analyzer" PrivateAssets="All" />
    <PackageReference Include="Google.Api.Gax" />
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
  <Import Project="Google.Cloud.BuiltInMetrics.csproj.google" Condition="Exists('Google.Cloud.BuiltInMetrics.csproj.google')" />
</Project>